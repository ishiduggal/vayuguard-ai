# Server port (Cloud Run injects PORT automatically, defaults to 8080)
PORT=8080

# Optional: Gemini API key for conversational multilingual explanations
# If omitted, VayuGuard AI runs cleanly with deterministic multilingual fallback responses.
GEMINI_API_KEY=

# Optional: Override default Gemini model (defaults to gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# Optional: Node environment
NODE_ENV=development
